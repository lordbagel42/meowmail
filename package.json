{
	"name": "meow-mail",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.22.0",
	"scripts": {
		"dev": "wrangler dev --ip 0.0.0.0",
		"check": "tsc --noEmit",
		"lint": "biome check src test public/*.js",
		"format": "biome format --write src test public package.json wrangler.jsonc tsconfig.json",
		"test": "wrangler deploy --dry-run --outdir dist && tsx --test test/*.test.ts",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"jose": "^6.1.0",
		"postal-mime": "^2.6.0",
		"typebox": "^1.4.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@cloudflare/workers-types": "latest",
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.2",
		"miniflare": "5.20261118.0-beta",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"wrangler": "^4.0.0"
	}
}
